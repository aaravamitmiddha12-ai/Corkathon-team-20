# Copy this file to secrets.toml (same folder) and fill in a key. secrets.toml is in .gitignore,
# so keys never get committed. Restart the app after changing it.

# Google Gemini: has a free tier (aistudio.google.com > Get API key)
GEMINI_API_KEY = "..."
LLM_PROVIDER = "gemini"

# Or Anthropic Claude: paid, needs credits (console.anthropic.com)
# ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: a different model
# LLM_MODEL = "gemini-3.5-flash"
